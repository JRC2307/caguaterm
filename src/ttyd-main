#!/bin/zsh
# Serve a persistent tmux session ("main") as a web terminal via ttyd.
#
# Reachable over Tailscale at:  http://js-mac-mini.tail82f3c6.ts.net:7681
# (binds 0.0.0.0; remote access is gated by the tailnet — WireGuard-encrypted,
#  not exposed to the public internet. Optionally front it with `tailscale
#  serve` for an HTTPS URL with no port: see notes at bottom of this file.)
#
# The tmux session survives disconnects, so `claude` keeps running between
# phone/laptop sessions. Start it once inside the session, e.g.:
#   claude --continue        (the session opens in ~/Desktop/1)

export PATH="/opt/homebrew/bin:$HOME/.local/bin:$PATH"

exec /opt/homebrew/bin/ttyd \
  --writable \
  --port 7681 \
  --index "$HOME/.local/share/ttyd-web/index.html" \
  --client-option fontSize=16 \
  --client-option 'theme={"background":"#1a1b26"}' \
  /opt/homebrew/bin/tmux new -A -s main -c "$HOME/Desktop/1"

# Custom index.html = ttyd's stock client + an on-screen key bar (arrows, Esc,
# Tab, Ctrl, ^B tmux prefix, window nav). Rebuild it after upgrading ttyd:
#   ~/.local/share/ttyd-web/build.sh
# Edit the bar itself in ~/.local/share/ttyd-web/keybar.snippet.html then rebuild.

# --- Optional: prettier HTTPS URL via Tailscale Serve ---------------------
# 1. Enable Serve on the tailnet (one-time): https://login.tailscale.com/admin
#    -> Settings -> Feature previews / "HTTPS Certificates" + enable Serve.
# 2. Change --port above to:  --interface 127.0.0.1 --port 7681
# 3. Run:  tailscale serve --bg --https=443 localhost:7681
# 4. Then browse to:  https://js-mac-mini.tail82f3c6.ts.net/
# -------------------------------------------------------------------------

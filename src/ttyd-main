#!/bin/zsh
# Serve a persistent tmux session ("main") as a web terminal via ttyd.
#
# Reachable over Tailscale at:  https://js-mac-mini.triceratops-adelie.ts.net:7681
# Binds 127.0.0.1 ONLY and requires Basic auth. `tailscale serve --https=7681`
# fronts it for the tailnet.
#
# Hardened (2026-07): loopback bind + Basic auth from a credential file. A bare
# 0.0.0.0 bind exposes a writable shell to the whole LAN, and the tailnet is NOT an
# authentication boundary (a lost phone is a tailnet device).
#
# No --check-origin: tailscale serve rewrites Host on the way to loopback, so
# the Origin check misfires and refuses every websocket ("press Enter to
# reconnect" loop). Basic auth + loopback bind remain the security boundary.
#
# The tmux session survives disconnects, so `claude` keeps running between
# phone/laptop sessions. Start it once inside the session, e.g.:
#   claude --continue        (the session opens in ~/Desktop/1)

export PATH="/opt/homebrew/bin:$HOME/.local/bin:$PATH"

CRED_FILE="$HOME/.config/ttyd/credential"
if [[ ! -s "$CRED_FILE" ]]; then
  print -u2 "ttyd-main: missing $CRED_FILE (expected 'user:password', chmod 600) — refusing to start an unauthenticated shell"
  exit 1
fi
CRED="$(<"$CRED_FILE")"

exec /opt/homebrew/bin/ttyd \
  --writable \
  --interface 127.0.0.1 \
  --port 7681 \
  --credential "$CRED" \
  --index "$HOME/.local/share/ttyd-web/index.html" \
  --client-option fontSize=16 \
  --client-option 'theme={"background":"#1a1b26"}' \
  --client-option 'rendererType=dom' \
  /opt/homebrew/bin/tmux new -A -s main -c "$HOME/Desktop/1"

# rendererType=dom: ttyd defaults to WebGL, which paints text on a canvas.
# On a canvas there is no real text node, so iOS Safari's long-press
# "select" gesture has nothing to grab. The DOM renderer outputs each row
# as real DOM nodes — native selection (and the Copy button in the key
# bar) then work normally. Trade-off: a bit slower on heavy output. Fine
# for an interactive shell session.

# Custom index.html = ttyd's stock client + an on-screen key bar (arrows, Esc,
# Tab, Ctrl, ^B tmux prefix, window nav). Rebuild it after upgrading ttyd:
#   ~/.local/share/ttyd-web/build.sh
# Edit the bar itself in ~/.local/share/ttyd-web/keybar.snippet.html then rebuild.

# --- Optional: prettier HTTPS URL via Tailscale Serve ---------------------
# 1. Enable Serve on the tailnet (one-time): https://login.tailscale.com/admin
#    -> Settings -> Feature previews / "HTTPS Certificates" + enable Serve.
# 2. Change --port above to:  --interface 127.0.0.1 --port 7681
# 3. Run:  tailscale serve --bg --https=443 localhost:7681
# 4. Then browse to:  https://js-mac-mini.triceratops-adelie.ts.net/
# -------------------------------------------------------------------------
